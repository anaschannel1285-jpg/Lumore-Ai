rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- VALIDATION BLUEPRINTS ---
    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidChatThread(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.lastMessagePreview is string && data.lastMessagePreview.size() <= 240 &&
             data.bookmarked is bool &&
             data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 5000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidChatMessage(data, userId, threadId) {
      return data.userId is string && data.userId == userId &&
             data.threadId is string && data.threadId == threadId &&
             data.role in ['USER', 'ASSISTANT'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 16000 &&
             data.hasImage is bool &&
             isValidTimestamp(data.createdAt);
    }

    // --- USER PROFILE COLLECTION ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'createdAt', 'updatedAt']);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      // --- CHAT THREADS SUBCOLLECTION ---
      match /chatThreads/{threadId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(threadId);

        allow create: if isOwner(userId) &&
                         isValidId(threadId) &&
                         isValidChatThread(incoming(), userId) &&
                         incoming().keys().hasAll(['userId', 'title', 'lastMessagePreview', 'bookmarked', 'messageCount', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'lastMessagePreview', 'bookmarked', 'messageCount', 'createdAt', 'updatedAt']);

        allow update: if isOwner(userId) &&
                         isValidId(threadId) &&
                         isValidChatThread(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['bookmarked', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'lastMessagePreview', 'messageCount', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(threadId);

        // --- CHAT MESSAGES SUBCOLLECTION ---
        match /messages/{messageId} {
          allow list: if isOwner(userId) && isValidId(threadId);
          allow get: if isOwner(userId) && isValidId(threadId) && isValidId(messageId);

          allow create: if isOwner(userId) &&
                           isValidId(threadId) &&
                           isValidId(messageId) &&
                           isValidChatMessage(incoming(), userId, threadId) &&
                           incoming().keys().hasAll(['userId', 'threadId', 'role', 'text', 'hasImage', 'createdAt']) &&
                           incoming().keys().hasOnly(['userId', 'threadId', 'role', 'text', 'hasImage', 'createdAt']) &&
                           existsAfter(/databases/$(database)/documents/users/$(userId)/chatThreads/$(threadId));

          allow update: if false;
          allow delete: if isOwner(userId) && isValidId(threadId) && isValidId(messageId);
        }
      }
    }
  }
}
